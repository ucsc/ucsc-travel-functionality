{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "UCSC Travel Functionality",
    "author": "UC Santa Cruz",
    "description": "Installs and activates the plugin, which renames Category to Expedition, with the UCSC 2022 theme and UCSC Custom Functionality."
  },
  "landingPage": "/wp-admin/edit-tags.php?taxonomy=category",
  "preferredVersions": {
    "php": "8.4",
    "wp": "latest"
  },
  "steps": [
    {
      "step": "login"
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "url",
        "url": "https://github.com/ucsc/ucsc-custom-functionality/releases/latest/download/ucsc-custom-functionality.zip"
      },
      "options": {
        "activate": true,
        "targetFolderName": "ucsc-custom-functionality"
      }
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "url",
        "url": "https://github.com/ucsc/ucsc-2022/releases/latest/download/ucsc-2022.zip"
      },
      "options": {
        "activate": true,
        "targetFolderName": "ucsc-2022"
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "git:directory",
        "url": "https://github.com/ucsc/ucsc-travel-functionality",
        "ref": "main",
        "refType": "branch"
      },
      "options": {
        "activate": true,
        "targetFolderName": "ucsc-travel-functionality"
      },
      "ifAlreadyInstalled": "skip"
    },
    {
      "step": "wp-cli",
      "command": "wp term create category 'Galápagos Islands'"
    },
    {
      "step": "wp-cli",
      "command": "wp term create category 'Patagonia'"
    }
  ]
}
